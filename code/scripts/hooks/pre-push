#!/bin/sh
# Blocks a push when the catalog audit fails, on a machine with reference/ (CI skips the audit), or when it would publish
# PHB text (code/scripts/check-phb.ts). Installed by `npm run hooks` in code/.
# git passes the pushed refs on stdin: the audit must not read them, and exec hands them on.
cd "$(git rev-parse --show-toplevel)/code" || exit 1
if [ -d ../reference ]; then npm run audit-catalog </dev/null || exit 1; fi
exec node scripts/check-phb.ts --pre-push
